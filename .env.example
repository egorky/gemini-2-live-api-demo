# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Deepgram API Key (optional)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Language for Gemini's responses (e.g., en-US, es-ES)
LANGUAGE=en-US

# Set to true to get text responses from Gemini, false for audio
TEXT_RESPONSE=false

# HTTPS Configuration
HTTPS_KEY_PATH=./key.pem
HTTPS_CERT_PATH=./cert.pem

# Server Port
PORT=3000
